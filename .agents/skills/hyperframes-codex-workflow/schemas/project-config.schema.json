{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hyperframes/project-config.schema.json",
  "title": "HyperFrames Workflow Project Config",
  "type": "object",
  "required": ["version", "project_name", "template", "profile", "output", "inputs", "timing", "voiceover", "plan"],
  "properties": {
    "version": {"const": 1},
    "project_name": {"type": "string", "minLength": 1},
    "template": {"enum": ["talking_head", "pure_hyperframes"]},
    "profile": {"enum": ["optical_fluidity", "kami_editorial", "monochrome_atelier"]},
    "output": {
      "type": "object",
      "required": ["ratio", "width", "height", "fps"],
      "properties": {
        "ratio": {"enum": ["16:9", "9:16", "source"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"const": 60}
      }
    },
    "inputs": {"type": "object"},
    "timing": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["source_locked", "audio_locked", "voiceover_pending", "visual_only"]},
        "authoritative_media": {"type": ["string", "null"]}
      }
    },
    "voiceover": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["source", "provided", "record_later", "ai_generated", "none"]}
      }
    },
    "image_assets": {"type": "object"},
    "plan": {
      "type": "object",
      "required": ["file", "approval_required"],
      "properties": {
        "file": {"type": "string"},
        "approval_required": {"const": true}
      }
    }
  }
}
