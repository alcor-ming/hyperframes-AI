{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hyperframes/animation-plan.schema.json",
  "title": "Optional machine representation of Animation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "status", "template", "profile", "ratio", "fps", "timing", "voiceover", "goal", "scenes"],
  "properties": {
    "version": {"const": 1},
    "status": {"enum": ["draft", "approved"]},
    "template": {"enum": ["talking_head", "pure_hyperframes"]},
    "profile": {"enum": ["optical_fluidity", "kami_editorial", "monochrome_atelier"]},
    "ratio": {"enum": ["16:9", "9:16", "source"]},
    "fps": {"const": 60},
    "timing": {"enum": ["source_locked", "audio_locked", "voiceover_pending", "visual_only"]},
    "voiceover": {"enum": ["source", "provided", "record_later", "ai_generated", "none"]},
    "authoritative_media": {"type": ["string", "null"]},
    "goal": {"type": "string", "minLength": 1},
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "anchor", "visual_goal", "hero_state", "motion", "assets"],
        "properties": {
          "id": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "anchor": {"type": "string", "minLength": 1},
          "visual_goal": {"type": "string", "minLength": 1},
          "hero_state": {"type": "string", "minLength": 1},
          "motion": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "assets": {"type": "array", "items": {"type": "string"}},
          "scene_type": {"type": "string"},
          "cues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["anchor", "event"],
              "properties": {
                "anchor": {"type": "string"},
                "event": {"type": "string"}
              },
              "additionalProperties": false
            }
          }
        }
      }
    },
    "asset_briefs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scene", "purpose", "composition", "ratio", "source", "forbidden"],
        "properties": {
          "id": {"type": "string", "pattern": "^IMG-[0-9]{3,}$"},
          "scene": {"type": "string", "pattern": "^S[0-9]{2,}$"},
          "purpose": {"type": "string"},
          "composition": {"type": "string"},
          "ratio": {"type": "string"},
          "source": {"enum": ["generated", "provided", "existing"]},
          "forbidden": {"type": "array", "items": {"type": "string"}}
        }
      },
      "default": []
    },
    "open_decisions": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string"},
      "default": []
    }
  }
}
