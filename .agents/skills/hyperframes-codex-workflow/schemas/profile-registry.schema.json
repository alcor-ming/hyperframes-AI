{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/hyperframes/profile-registry.schema.json",
  "title": "Stable Profile Registry",
  "type": "object",
  "required": [
    "version",
    "profiles"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "profile_path",
          "tokens_path",
          "motion_primitives"
        ],
        "properties": {
          "id": {
            "enum": [
              "optical_fluidity",
              "kami_editorial",
              "monochrome_atelier"
            ]
          },
          "display_name": {
            "type": "string"
          },
          "profile_path": {
            "type": "string"
          },
          "tokens_path": {
            "type": "string"
          },
          "motion_primitives": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
