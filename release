#!/usr/bin/env python3
"""Build and activate immutable local Harness releases."""

from __future__ import annotations

import argparse
from datetime import datetime, timezone
import gzip
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile


REPO = Path(__file__).resolve().parent
DEFAULT_RELEASE_ROOT = Path.home() / ".local" / "share" / "hyperframes-ai"
DEFAULT_WORK_ROOT = Path("/mnt/d/AI/AI+hyperframes")
LOCAL_SKILLS = {
    "dbs": "b0290051cf5563047d5b0a5a3e55dcf046c2dff1a1b66e299825a4462c9507ce",
    "dbs-ai-check": "1f2703581914ae9bff5384196a08138fa55e64f70ad4427d95ee220c7ee5e2d9",
    "dbs-content": "7c563a272d2d2e6715fba39441aee06acb4fec18dc88724e0236c05a815d1cac",
    "dbs-resonate": "c441e1b6f443324e9fdb54266930642f704af6e95ee72a3fb72be91d2fa4001e",
    "dbs-spread": "84daa2f4cb15b0078bc46ace0b780e61528adf5c9d5416497a67ef17e2820c5f",
    "dbs-xhs-title": "4474ad23c2a904215d146ab8093d72b1469fc7a96ab37d68d479590f07b0c793",
    "design-taste-frontend": "eb6d1b2e9c86123ebd153123e1f12e16955c7d43a1ec28495c48f29f2641481e",
}
VERSION_PATTERN = re.compile(r"^(?:harness-)?(\d{4}\.\d{2}\.\d+)$")


class ReleaseError(RuntimeError):
    pass


def run(*args: str, cwd: Path = REPO, capture: bool = False) -> str:
    result = subprocess.run(
        args,
        cwd=cwd,
        check=True,
        text=True,
        stdout=subprocess.PIPE if capture else None,
    )
    return result.stdout.strip() if capture else ""


def version_tag(value: str) -> tuple[str, str]:
    match = VERSION_PATTERN.fullmatch(value)
    if not match:
        raise ReleaseError("Version must look like 2026.09.0 or harness-2026.09.0")
    version = match.group(1)
    return version, f"harness-{version}"


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def directory_sha256(root: Path) -> str:
    digest = hashlib.sha256()
    for path in sorted(p for p in root.rglob("*") if p.is_file() and "__pycache__" not in p.parts):
        if path.suffix in {".pyc", ".pyo"}:
            continue
        relative = path.relative_to(root).as_posix().encode()
        digest.update(len(relative).to_bytes(4, "big"))
        digest.update(relative)
        digest.update(bytes.fromhex(sha256(path)))
    return digest.hexdigest()


def release_checks(root: Path) -> None:
    env = os.environ.copy()
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    subprocess.run(
        [sys.executable, "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py", "-q"],
        cwd=root,
        env=env,
        check=True,
    )
    subprocess.run(
        [sys.executable, ".agents/skills/hyperframes-codex-workflow/scripts/validate_package.py"],
        cwd=root,
        env=env,
        check=True,
    )


def write_archive(source: Path, archive: Path, prefix: str, mtime: int) -> None:
    def normalize(info: tarfile.TarInfo) -> tarfile.TarInfo:
        info.uid = info.gid = 0
        info.uname = info.gname = ""
        info.mtime = mtime
        info.mode = 0o755 if info.isdir() or info.mode & 0o111 else 0o644
        return info

    with archive.open("wb") as raw:
        with gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as compressed:
            with tarfile.open(fileobj=compressed, mode="w") as bundle:
                bundle.add(source, arcname=prefix, recursive=False, filter=normalize)
                for path in sorted(source.rglob("*")):
                    bundle.add(path, arcname=f"{prefix}/{path.relative_to(source).as_posix()}", recursive=False, filter=normalize)


def build(version_value: str, output_dir: Path) -> Path:
    version, tag = version_tag(version_value)
    if run("git", "status", "--porcelain", capture=True):
        raise ReleaseError("Refusing to build from a dirty working tree")
    head = run("git", "rev-parse", "HEAD", capture=True)
    tagged = run("git", "rev-parse", f"{tag}^{{commit}}", capture=True)
    if tagged != head:
        raise ReleaseError(f"{tag} does not point at HEAD")
    try:
        if int(run("git", "rev-list", "--count", "@{upstream}..HEAD", capture=True)):
            raise ReleaseError("Refusing to build commits that are ahead of the upstream branch")
    except subprocess.CalledProcessError as exc:
        raise ReleaseError("The current branch needs an upstream before release") from exc

    output_dir.mkdir(parents=True, exist_ok=True)
    archive = output_dir / f"hyperframes-ai-harness-{version}.tar.gz"
    checksum = archive.with_suffix(archive.suffix + ".sha256")
    if archive.exists() or checksum.exists():
        raise ReleaseError(f"Release artifact already exists: {archive}")

    with tempfile.TemporaryDirectory() as temporary:
        staging = Path(temporary) / tag
        staging.mkdir()
        git_tar = Path(temporary) / "tracked.tar"
        run("git", "archive", "--format=tar", "-o", str(git_tar), tag)
        with tarfile.open(git_tar) as bundle:
            bundle.extractall(staging, filter="data")

        dependency_hashes: dict[str, str] = {}
        for name, locked_hash in LOCAL_SKILLS.items():
            source = REPO / ".agents" / "skills" / name
            if not (source / "SKILL.md").is_file():
                raise ReleaseError(f"Missing local release dependency: {source}")
            actual_hash = directory_sha256(source)
            if actual_hash != locked_hash:
                raise ReleaseError(f"Local release dependency changed; update its lock deliberately: {name}")
            target = staging / ".agents" / "skills" / name
            shutil.copytree(source, target)
            dependency_hashes[name] = actual_hash

        timestamp = int(run("git", "show", "-s", "--format=%ct", tag, capture=True))
        manifest = {
            "schema_version": 1,
            "release": tag,
            "commit": head,
            "built_at": datetime.fromtimestamp(timestamp, timezone.utc).isoformat(timespec="seconds"),
            "local_skill_sha256": dependency_hashes,
        }
        (staging / ".release.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
        release_checks(staging)
        write_archive(staging, archive, tag, timestamp)

    checksum.write_text(f"{sha256(archive)}  {archive.name}\n", encoding="ascii")
    print(archive)
    return archive


def verified_archive(archive: Path) -> str:
    checksum = archive.with_suffix(archive.suffix + ".sha256")
    if not archive.is_file() or not checksum.is_file():
        raise ReleaseError("Archive and matching .sha256 file are required")
    fields = checksum.read_text(encoding="ascii").strip().split()
    if len(fields) != 2 or fields[1] != archive.name or fields[0] != sha256(archive):
        raise ReleaseError(f"Checksum verification failed: {archive}")
    with tarfile.open(archive) as bundle:
        roots = {Path(member.name).parts[0] for member in bundle.getmembers() if member.name}
    if len(roots) != 1:
        raise ReleaseError("Release archive must contain exactly one top-level directory")
    return roots.pop()


def replace_link(link: Path, target: Path) -> None:
    if link.exists() and not link.is_symlink():
        raise ReleaseError(f"Refusing to replace a real path: {link}")
    temporary = link.with_name(f".{link.name}.{os.getpid()}")
    temporary.unlink(missing_ok=True)
    temporary.symlink_to(target)
    os.replace(temporary, link)


def activate(release_root: Path, destination: Path) -> None:
    current = release_root / "current"
    previous = release_root / "previous"
    if current.is_symlink():
        old = current.resolve(strict=True)
        if old != destination:
            replace_link(previous, old)
    replace_link(current, destination)


def deploy(archive: Path, release_root: Path, work_root: Path) -> None:
    tag = verified_archive(archive)
    _, expected_tag = version_tag(tag)
    if tag != expected_tag:
        raise ReleaseError(f"Unexpected archive root: {tag}")
    for name in ("active", "parked", "archive"):
        if not (work_root / "works" / name).is_dir():
            raise ReleaseError(f"Invalid WorkStore; missing works/{name}: {work_root}")

    releases = release_root / "releases"
    releases.mkdir(parents=True, exist_ok=True)
    destination = releases / tag
    if destination.exists():
        raise ReleaseError(f"Release is already installed: {destination}")

    with tempfile.TemporaryDirectory(prefix=".deploy-", dir=releases) as temporary:
        with tarfile.open(archive) as bundle:
            bundle.extractall(temporary, filter="data")
        staged = Path(temporary) / tag
        manifest = json.loads((staged / ".release.json").read_text(encoding="utf-8"))
        if manifest.get("release") != tag:
            raise ReleaseError("Release manifest does not match the archive")
        dependency_hashes = manifest.get("local_skill_sha256")
        if not isinstance(dependency_hashes, dict) or not dependency_hashes:
            raise ReleaseError("Release dependency lock is missing")
        for name, expected in dependency_hashes.items():
            actual = directory_sha256(staged / ".agents" / "skills" / name)
            if actual != expected:
                raise ReleaseError(f"Bundled Skill failed verification: {name}")
        release_checks(staged)
        run(sys.executable, "work", "root", "set", str(work_root), cwd=staged)
        run(sys.executable, "work", "root", "show", cwd=staged)
        shutil.move(staged, destination)

    activate(release_root, destination)
    print(destination)


def rollback(release_root: Path) -> None:
    current = release_root / "current"
    previous = release_root / "previous"
    if not current.is_symlink() or not previous.is_symlink():
        raise ReleaseError("Both current and previous releases are required for rollback")
    old_current = current.resolve(strict=True)
    old_previous = previous.resolve(strict=True)
    replace_link(current, old_previous)
    replace_link(previous, old_current)
    print(old_previous)


def status(release_root: Path) -> None:
    result: dict[str, str | None] = {}
    for name in ("current", "previous"):
        link = release_root / name
        result[name] = str(link.resolve()) if link.is_symlink() and link.exists() else None
    print(json.dumps(result, indent=2))


def parser() -> argparse.ArgumentParser:
    command = argparse.ArgumentParser(description=__doc__)
    subcommands = command.add_subparsers(dest="command", required=True)
    build_parser = subcommands.add_parser("build")
    build_parser.add_argument("version")
    build_parser.add_argument("--output-dir", type=Path, default=REPO / "dist")
    deploy_parser = subcommands.add_parser("deploy")
    deploy_parser.add_argument("archive", type=Path)
    deploy_parser.add_argument("--release-root", type=Path, default=DEFAULT_RELEASE_ROOT)
    deploy_parser.add_argument("--work-root", type=Path, default=DEFAULT_WORK_ROOT)
    for name in ("status", "rollback"):
        child = subcommands.add_parser(name)
        child.add_argument("--release-root", type=Path, default=DEFAULT_RELEASE_ROOT)
    return command


def main(arguments: list[str] | None = None) -> int:
    args = parser().parse_args(arguments)
    try:
        if args.command == "build":
            build(args.version, args.output_dir.resolve())
        elif args.command == "deploy":
            deploy(args.archive.resolve(), args.release_root.resolve(), args.work_root.resolve())
        elif args.command == "rollback":
            rollback(args.release_root.resolve())
        else:
            status(args.release_root.resolve())
    except (ReleaseError, subprocess.CalledProcessError, OSError, json.JSONDecodeError) as exc:
        print(f"release: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
